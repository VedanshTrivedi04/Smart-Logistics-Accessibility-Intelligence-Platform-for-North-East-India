# NER Logistics Platform — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# ─────────────────────────────────────────────────────────
# Neon PostgreSQL — TWO connection strings required
#
# POOLED   = application runtime (PgBouncer, transaction mode)
# DIRECT   = Alembic migrations only (needs persistent connections)
#
# Get both from: https://console.neon.tech/app/projects/bitter-morning-62573618
# Toggle "Connection pooling" ON for pooled, OFF for direct.
# ─────────────────────────────────────────────────────────

# App runtime (pooled via PgBouncer — use this for FastAPI/SQLAlchemy)
DATABASE_URL="postgresql+asyncpg://ner_admin:npg_bG5P9AzsNduZ@ep-broad-wave-b334q3tk-pooler.c-4.ap-southeast-1.aws.neon.tech/ner_logistics?ssl=require"

# Alembic migrations only (direct, non-pooled — NOT for app runtime)
DATABASE_URL_DIRECT="postgresql+asyncpg://ner_admin:npg_bG5P9AzsNduZ@ep-broad-wave-b334q3tk.c-4.ap-southeast-1.aws.neon.tech/ner_logistics?ssl=require"

# Neon project info (for reference / MCP tooling)
NEON_PROJECT_ID="bitter-morning-62573618"
NEON_BRANCH_ID="br-summer-star-b3jizkwm"

# ─────────────────────────────────────────────────────────
# Redis — local Docker (dev) or managed Redis (prod)
# ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_CELERY_URL="redis://localhost:6379/1"

# ─────────────────────────────────────────────────────────
# MinIO / S3-compatible object storage
# ─────────────────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_ACCESS_KEY="ner_minio_admin"
OBJECT_STORAGE_SECRET_KEY="ner_minio_secret"
OBJECT_STORAGE_BUCKET_QUARANTINE="ner-media-quarantine"
OBJECT_STORAGE_BUCKET_CLEAN="ner-media-clean"
OBJECT_STORAGE_REGION="us-east-1"   # MinIO ignores this; required by boto3

# ─────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────
SESSION_SECRET="CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING_HERE"
CSRF_SECRET="CHANGE_ME_CSRF_SECRET_DIFFERENT_FROM_SESSION"
TOKEN_HMAC_KEY="CHANGE_ME_32_BYTE_HEX_KEY_FOR_TOKEN_DIGESTS_MIN32CHARS"
SESSION_ABSOLUTE_LIFETIME_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=60
STRICT_ORIGIN_CHECK=false
ALLOWED_ORIGINS="http://localhost:3000"

# ─────────────────────────────────────────────────────────
# OIDC (Identity Provider)
# Dev: set DEV_JWT_MODE=true to use local mock JWT (no real OIDC)
# Prod: fill OIDC_ISSUER and OIDC_CLIENT_ID
# ─────────────────────────────────────────────────────────
DEV_JWT_MODE=true
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:8000/api/v1/auth/oidc/callback"
OIDC_SCOPES="openid email profile"

# ─────────────────────────────────────────────────────────
# Application settings
# ─────────────────────────────────────────────────────────
APP_ENV="development"         # development | staging | production
DEMO_MODE=true                # Enables /seed-demo endpoint; NEVER true in prod
LOG_LEVEL="DEBUG"
APP_HOST="0.0.0.0"
APP_PORT=8000

# Route plan expiry (minutes)
ROUTE_PLAN_EXPIRY_MINUTES=30

# GPS stale threshold (minutes)
GPS_STALE_THRESHOLD_MINUTES=15

# Media limits
MEDIA_MAX_FILE_SIZE_MB=20
MEDIA_MAX_FILES_PER_REPORT=5

# Outbox age alert threshold (seconds)
OUTBOX_AGE_ALERT_SECONDS=30
